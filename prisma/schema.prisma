generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER")
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)
  orders        Order[]
  accounts      Account[]
  sessions      Session[]
  tickets       SupportTicket[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs     AuditLog[]

  // Security & 2FA
  twoFactorEnabled Boolean              @default(false)
  totpSecret       String?
  backupCodes      BackupCode[]
  devices          UserDevice[]
  webAuthnCreds    WebAuthnCredential[]
}

model Product {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  subtitle       String
  price          Float
  rating         Float        @default(0)
  reviewCount    Int          @default(0)
  material       String
  finish         String?
  tolerance      String?
  dimensions     String
  weight         String
  image          String
  description    String
  specifications Json
  applications   String[]
  leadTime       String
  minimumOrder   Int
  inStock        Boolean      @default(true)
  stockLevel     Int          @default(0)
  safetyStock    Int          @default(0)
  reorderPoint   Int          @default(0)
  leadTimeDays   Int          @default(7)
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId     String?
  orderItems     OrderItem[]
  movements      InventoryMovement[]
  variants       Variant[]
  images         ProductImage[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([categoryId])
}

model Variant {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  sku        String   @unique
  price      Float
  attributes Json     // free-form e.g., {"size":"M","color":"Black"}
  stockLevel Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orderItems OrderItem[]
}

model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  user            User?        @relation(fields: [userId], references: [id])
  userId          String?
  email           String
  status          OrderStatus  @default(PENDING)
  total           Int          // store in cents
  currency        String       @default("usd")
  paymentProvider String?
  paymentIntentId String?
  refundStatus    RefundStatus @default(NONE)
  items           OrderItem[]
  refunds         Refund[]
  rmas            ReturnRequest[]
  shipments       Shipment[]
  shippingName    String?
  shippingPhone   String?
  // Legacy full address fallback
  shippingAddress String?
  // Structured shipping address
  shippingAddress1 String?
  shippingAddress2 String?
  shippingCity     String?
  shippingState    String?
  shippingPostalCode String?
  shippingCountry  String?     @default("US")
  shippingLat      Float?
  shippingLng      Float?
  trackingCarrier String?
  trackingNumber  String?
  trackingUrl     String?
  shippedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  variant   Variant? @relation(fields: [variantId], references: [id])
  variantId String?
  name      String
  price     Int      // in cents
  quantity  Int
  createdAt DateTime @default(now())
  returnItems ReturnItem[]
}

model InventoryMovement {
  id        String         @id @default(cuid())
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  type      MovementType
  quantity  Int            // positive for restock/adjustment, negative for sale
  note      String?
  createdAt DateTime       @default(now())
}

model Refund {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  amount     Int      // cents
  reason     String?
  provider   String?  // stripe/paypal
  providerRefundId String?
  status     RefundStatus @default(PARTIAL)
  createdAt  DateTime @default(now())
  processedAt DateTime?
}

model ReturnRequest {
  id         String      @id @default(cuid())
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  status     RmaStatus   @default(REQUESTED)
  reason     String?
  items      ReturnItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model ReturnItem {
  id           String        @id @default(cuid())
  rma          ReturnRequest @relation(fields: [rmaId], references: [id], onDelete: Cascade)
  rmaId        String
  orderItem    OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId  String
  requestedQty Int
  receivedQty  Int           @default(0)
}

model Shipment {
  id                 String            @id @default(cuid())
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId            String
  carrier            String?
  service            String?
  trackingNumber     String?
  trackingUrl        String?
  status             ShipmentStatus    @default(CREATED)
  labelUrl           String?
  labelCost          Int?
  labelCurrency      String?           @default("usd")
  provider           ShippingProvider  @default(MOCK)
  providerShipmentId String?
  rawEvents          Json?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  items              ShipmentItem[]
  events             ShipmentEvent[]

  @@index([orderId])
  @@index([status])
  @@unique([trackingNumber])
}

model ShipmentItem {
  id           String     @id @default(cuid())
  shipment     Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId   String
  orderItem    OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId  String
  quantity     Int

  @@index([shipmentId])
  @@index([orderItemId])
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId String
  status     ShipmentStatus?
  description String?
  location   String?
  occurredAt DateTime
  raw        Json?

  @@index([shipmentId, occurredAt])
}

model SupportTicket {
  id        String           @id @default(cuid())
  user      User?            @relation(fields: [userId], references: [id])
  userId    String?
  email     String
  subject   String
  status    TicketStatus     @default(OPEN)
  messages  SupportMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model SupportMessage {
  id        String       @id @default(cuid())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  author    MessageAuthor
  body      String
  createdAt DateTime      @default(now())
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  payloadHash String
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  isVisible   Boolean    @default(true)
  order       Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isVisible, order])
  @@index([parentId])
}

// 2FA backup codes
model BackupCode {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Registered/trusted devices
model UserDevice {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String?
  fingerprint String?
  userAgent   String?
  ip          String?
  trusted     Boolean  @default(false)
  lastSeen    DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, trusted])
}

// WebAuthn credentials (optional)
model WebAuthnCredential {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  credentialId  String   @unique
  publicKey     String
  counter       Int      @default(0)
  name          String?
  createdAt     DateTime @default(now())

  @@index([userId])
}

enum NavigationLocation {
  HEADER
  FOOTER
}

model NavigationItem {
  id        String             @id @default(cuid())
  location  NavigationLocation
  key       String
  label     String
  url       String
  icon      String?
  order     Int                @default(0)
  isVisible Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([location, key])
  @@index([location, order])
}

enum AttributeType {
  STRING
  NUMBER
}

model AllowedAttribute {
  id        String        @id @default(cuid())
  key       String        @unique
  label     String
  type      AttributeType @default(STRING)
  options   String[]      // if present, values must be one of these
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  SUPPORT
  WAREHOUSE
  CUSTOMER
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum RefundStatus {
  NONE
  REQUESTED
  PARTIAL
  FULL
}

enum MovementType {
  SALE
  RESTOCK
  ADJUSTMENT
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
}

enum MessageAuthor {
  CUSTOMER
  AGENT
}

enum RmaStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  REFUNDED
}

enum ShipmentStatus {
  CREATED
  LABEL_PURCHASED
  PRE_TRANSIT
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED
}

enum ShippingProvider {
  SHIPPO
  EASYPOST
  AFTERSHIP
  MOCK
}