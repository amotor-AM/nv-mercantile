# Database
# For production SSR on Cloudflare Pages, use a managed Postgres/MySQL provider.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# PayPal
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# App URL (for PayPal/Stripe redirects)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Strong secret required in production (32+ random bytes). Can also use AUTH_SECRET for v5.
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# OAuth Providers (optional but recommended)
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_ID=""
GOOGLE_SECRET=""

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Analytics (optional)
NEXT_PUBLIC_GA_ID=""

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM="NV Mercantile <orders@yourdomain.com>"
INVENTORY_ALERT_EMAIL="ops@yourdomain.com"

# Inventory
ALLOW_BACKORDER="false"

# Observability (optional)
SENTRY_DSN=""

# Clerk (legacy; unused)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""