# Database
# For production SSR on Cloudflare Pages, use a managed Postgres/MySQL provider.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# PayPal
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# App URL (for PayPal/Stripe redirects)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_me

# Auth Providers
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# Provider Selection
SHIPPING_PROVIDER=mock
SHIPPO_API_KEY=

# Email
RESEND_API_KEY=

# Feature Flags
NEXT_PUBLIC_GA_ID=

# Logging
LOG_LEVEL=info
LOG_SERVICE_NAME=nv-mercantile
LOG_SINK_URL=

# 2FA
TOTP_ISSUER=NV Mercantile

# Compliance
SUPPORT_TICKET_RETENTION_DAYS=365""

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM="NV Mercantile <orders@yourdomain.com>"
INVENTORY_ALERT_EMAIL="ops@yourdomain.com"

# Inventory
ALLOW_BACKORDER="false"

# Observability (optional)
SENTRY_DSN=""

# Shipping / Fulfillment
# SHIPPING_PROVIDER can be: mock | shippo | easypost | aftership (mock by default)
SHIPPING_PROVIDER="mock"
# For Shippo (optional)
SHIPPO_API_KEY=""
# Origin address (used for label creation)
SHIP_FROM_NAME="Warehouse"
SHIP_FROM_ADDRESS="123 Warehouse St"
SHIP_FROM_CITY=""
SHIP_FROM_STATE=""
SHIP_FROM_ZIP=""
SHIP_FROM_COUNTRY="US"
SHIP_FROM_PHONE=""

# Clerk (legacy; unused)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""